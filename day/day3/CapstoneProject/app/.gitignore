# ==========================================
# FastAPI / Python Standard Gitignore
# ==========================================

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (Always ignore local envs)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
.envrc

# Databases (Local development SQLite data)
*.sqlite3
*.db
db.sqlite3-journal

# FastAPI / Application Logs
logs/
*.log
*.log.*
*.out

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type Checkers and Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Project Documentation
/site
docs/_build/

# ==========================================
# IDEs and Editors
# ==========================================

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
